      "notes": [
        {
          "type": "emphasis",
          "at": "end",
          "text": "Las palabras se parecen, pero el <b>género no siempre coincide</b>: <i>das</i> Problem (el problema), <i>die</i> Information… y <b>se pronuncian a la alemana</b>: <i>Restaurant</i> [restorán], <i>Zentrum</i> [tséntrum]. Mira la figurada en cada tarjeta."
        }
      ],
      "quiz": [
        {
          "id": "b36-s1q1",
          "question": "1. ¿Qué artículo lleva Problem?",
          "options": [
            "der",
            "die",
            "das"
          ],
          "correctIndex": 2,
          "explain": "<b>das</b> Problem: muchas palabras extranjeras en <b>-em</b> son neutras (das System, das Thema)."
        },
        {
          "id": "b36-s1q2",
          "question": "2. die Apotheke es…",
          "options": [
            "la bodega",
            "la farmacia",
            "la biblioteca"
          ],
          "correctIndex": 1,
          "explain": "<b>die Apotheke</b> = la farmacia. La biblioteca es <i>die Bibliothek</i>."
        },
        {
          "id": "b36-s1q3",
          "question": "3. Plural de das Museum:",
          "options": [
