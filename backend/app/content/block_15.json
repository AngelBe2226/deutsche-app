          "en": "<span class=\"r-nom\">Du</span> <span class=\"r-verb\">siehst</span> müde aus.",
          "es": "Pareces cansado. (e→ie)"
        },
        {
          "en": "<span class=\"r-nom\">Sie</span> <span class=\"r-verb\">liest</span> ein Buch.",
