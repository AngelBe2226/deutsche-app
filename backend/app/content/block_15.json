        },
        {
          "en": "<span class=\"r-nom\">Er</span> <span class=\"r-verb\">gibt</span> mir das Buch.",
          "es": "Él me da el libro. (e→i)"
        },
        {
          "en": "<span class=\"r-nom\">Sie</span> <span class=\"r-verb\">nimmt</span> den Bus.",
          "es": "Ella coge el autobús. (e→i)"
        },
        {
          "en": "<span class=\"r-nom\">Du</span> <span class=\"r-verb\">hilfst</span> mir.",
