# Copia este archivo como .env.local (en esta misma carpeta) y rellena los
# valores. .env.local NUNCA se sube a git: está en .gitignore.

# Voz alemana con Piper (gratis, en este Mac). Modelos en scripts/audio/.models
PIPER_MODEL=de_DE-thorsten-high
# Solo para modelos con varias voces (p. ej. de_DE-mls-medium → 3885)
PIPER_SPEAKER=

# Cloudflare R2: bucket propio de esta app (deutsche-app-audio) con su propia clave
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deutsche-app-audio
# Dirección pública del bucket (la app la usa para reproducir), sin / final
AUDIO_PUBLIC_BASE=

# Generación automática del audio del contenido nuevo (1 = activada)
AUDIO_AUTO=0
# Hasta qué fase generar en automático (1 lecciones · 2 palabras · 3 verbos · 4 verbos+ · 5 tablas)
AUDIO_PHASE=5
# Verbos: solo los N más frecuentes (vacío = los ~9.300)
AUDIO_VERBS=
# Tope opcional de caracteres por pasada (vacío = sin tope; la generación
# solo funciona de 8:00 a 24:00 y para sola a medianoche)
AUDIO_MAX_CHARS_PER_RUN=
